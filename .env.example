# Copy to .env (never commit .env). Values below are local-demo placeholders,
# not real secrets; change them if the stack is ever reachable by others.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-admin

TRUSTTRAIL_CLIENT_SECRET=change-me-trusttrail
