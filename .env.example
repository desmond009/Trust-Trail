# Copy to .env (never commit .env). Values below are local-demo placeholders,
# not real secrets; change them if the stack is ever reachable by others.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-admin

TRUSTTRAIL_CLIENT_SECRET=change-me-trusttrail
LIBRARY_CLIENT_SECRET=change-me-library
LMS_CLIENT_SECRET=change-me-lms
EXAM_CLIENT_SECRET=change-me-exam
DASHBOARD_CLIENT_SECRET=change-me-dashboard
OVERASKER_CLIENT_SECRET=change-me-overasker
RETAINER_CLIENT_SECRET=change-me-retainer
TIERCAP_CLIENT_SECRET=change-me-tiercap
# Evaluation (Phase 6): plain-OIDC latency baseline and usability-study consent screens.
BENCH_BASELINE_CLIENT_SECRET=change-me-bench
STUDY_CLIENT_SECRET=change-me-study

# Bearer token for TrustTrail's admin endpoints (trust reset, sync).
TRUSTTRAIL_ADMIN_TOKEN=change-me-admin-token

SESSION_SECRET=change-me-session
STUDENT_DEMO_PASSWORD=student123

# Blockchain anchoring (Phase 5). Default: the local Hardhat chain from docker compose.
# This key is Hardhat's PUBLIC test account #0 (from the "test test ... junk" mnemonic);
# it is not a secret and must never hold real funds. For Sepolia, see README.
ANCHOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# ANCHOR_INTERVAL_SECONDS=300
# ANCHOR_NETWORK=sepolia
# CHAIN_RPC_URL=https://sepolia.example-rpc.invalid/<your-key>
