EXAM_CLIENT_SECRET=change-me-exam
DASHBOARD_CLIENT_SECRET=change-me-dashboard
OVERASKER_CLIENT_SECRET=change-me-overasker
RETAINER_CLIENT_SECRET=change-me-retainer
